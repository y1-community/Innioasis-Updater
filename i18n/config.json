    "rom_type_b.zip",
    "rom_g1.zip",
    "rom_g3.zip",
    "rom_g5.zip",
    "rom_pr1.zip",
    "rom_q3.zip",
    "rom_q5.zip",
    "rom_r1.zip",
    "rom_sr1.zip",
    "system.zip",
    "scatter.txt",
