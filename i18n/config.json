{
  "version": 1,
  "sourceLocale": "en",
  "catalogDir": "i18n/catalogs",
  "cacheDir": "i18n/cache",
  "stringsFile": "i18n/strings/en.json",
  "skipTags": [
    "script",
    "style",
    "pre",
    "code",
    "kbd",
    "samp",
    "textarea"
  ],
  "skipAttributes": [
    "data-i18n-skip",
    "translate=\"no\""
  ],
  "attributeNames": [
    "title",
    "alt",
    "placeholder",
    "aria-label",
    "aria-description"
  ],
  "metaAttributeNames": [
    "content"
  ],
  "protectedTerms": [
